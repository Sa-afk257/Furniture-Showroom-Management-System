<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="com.furniture.ui.LoginController"
    stylesheets="@../style/login.css"
    styleClass="login-root">

    <StackPane AnchorPane.topAnchor="0.0"
        AnchorPane.bottomAnchor="0.0"
        AnchorPane.leftAnchor="0.0"
        AnchorPane.rightAnchor="0.0"
        styleClass="login-background-layer">

        <ImageView fitWidth="1366"
            fitHeight="768"
            preserveRatio="false"
            smooth="true">
            <image>
                <Image url="@../images/login_background.jpg" />
            </image>
        </ImageView>

        <Region styleClass="login-dark-overlay" />

        <Region styleClass="login-dark-overlay" />
        <HBox fx:id="authContainer"
            alignment="CENTER"
            spacing="22"
            styleClass="auth-container">
            <VBox alignment="CENTER"
                spacing="12"
                styleClass="login-card">

                <HBox alignment="TOP_RIGHT" maxWidth="Infinity">
                    <Button fx:id="backBtn"
                        text="×"
                        onAction="#goBack"
                        styleClass="back-arrow-btn" />
                </HBox>

                <ImageView fitWidth="250"
                    preserveRatio="true"
                    smooth="true"
                    styleClass="main-logo">
                    <image>
                        <Image url="@../images/Furniture_logo.jpg" />
                    </image>
                </ImageView>

                <Label text="Welcome Back" styleClass="login-title" />
                <Label text="Login to access your dashboard" styleClass="login-subtitle" />

                <HBox alignment="CENTER_LEFT" spacing="18" styleClass="input-box">
                    <Label text="👤" styleClass="input-icon" />
                    <TextField fx:id="usernameField"
                        promptText="Username or Email"
                        styleClass="input-field" />
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="18" styleClass="input-box">
                    <Label text="🔒" styleClass="input-icon" />
                    <PasswordField fx:id="passwordField"
                        promptText="Password"
                        styleClass="input-field" />
                    <Region HBox.hgrow="ALWAYS" />
                </HBox>

                <HBox alignment="CENTER_LEFT" prefWidth="470">
                    <Region HBox.hgrow="ALWAYS" />
                    <Hyperlink text="Forgot Password?"
                        onAction="#handleForgotPassword"
                        styleClass="signup-link" />
                </HBox>

                <Button fx:id="loginButton" text="LOGIN" styleClass="login-btn" />

                <HBox alignment="CENTER" spacing="14">
                    <Separator prefWidth="190" />
                    <Label text="or" styleClass="or-text" />
                    <Separator prefWidth="190" />
                </HBox>

                <Button fx:id="guestButton"
                    text="👤   CONTINUE AS GUEST"
                    styleClass="guest-btn" />

                <HBox alignment="CENTER" spacing="14">
                    <Separator prefWidth="145" />
                    <Label text="or" styleClass="or-text" />
                    <Separator prefWidth="145" />
                </HBox>

                <Hyperlink fx:id="showSignupLink"
                    text="Create New Account"
                    onAction="#showSignupPanel"
                    styleClass="signup-link" />

            </VBox>

            <!-- SIGNUP CARD -->
            <VBox fx:id="signupCard"
                alignment="CENTER"
                spacing="11"
                visible="false"
                managed="false"
                styleClass="signup-card">

                <Label text="Create Account" styleClass="login-title" />
                <Label text="Fill customer account information"
                    styleClass="login-subtitle" />

                <HBox spacing="10" alignment="CENTER">
                    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="small-input-box">
                        <TextField fx:id="firstNameField"
                            promptText="First Name"
                            styleClass="input-field" />
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="small-input-box">
                        <TextField fx:id="lastNameField"
                            promptText="Last Name"
                            styleClass="input-field" />
                    </HBox>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="18" styleClass="signup-input-box">
                    <Label text="✉" styleClass="input-icon" />
                    <TextField fx:id="emailField"
                        promptText="Email"
                        styleClass="input-field" />
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="18" styleClass="signup-input-box">
                    <Label text="☎" styleClass="input-icon" />
                    <TextField fx:id="phoneField"
                        promptText="Phone Number"
                        styleClass="input-field" />
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="18" styleClass="signup-input-box">
                    <Label text="🔒" styleClass="input-icon" />
                    <PasswordField fx:id="signupPasswordField"
                        promptText="Password"
                        styleClass="input-field" />
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="18" styleClass="signup-input-box">
                    <Label text="🔒" styleClass="input-icon" />
                    <PasswordField fx:id="confirmPasswordField"
                        promptText="Confirm Password"
                        styleClass="input-field" />
                </HBox>

                <Button fx:id="signupButton"
                    text="SIGN UP"
                    onAction="#handleSignup"
                    styleClass="login-btn" />

                <HBox alignment="CENTER" spacing="5">
                    <Label text="Already have an account?" styleClass="bottom-text" />
                    <Hyperlink text="Sign in"
                        onAction="#hideSignupPanel"
                        styleClass="signup-link" />
                </HBox>

            </VBox>

        </HBox>
    </StackPane>
</AnchorPane>


