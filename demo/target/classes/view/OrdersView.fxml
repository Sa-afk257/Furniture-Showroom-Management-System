<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<BorderPane xmlns="http://javafx.com/javafx"
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="com.furniture.ui.OrdersController"
    stylesheets="@../style/orders.css"
    styleClass="root-pane">

    <center>
        <VBox spacing="0" styleClass="main-area">

            <VBox spacing="0" styleClass="dashboard-header">
                <HBox alignment="CENTER_LEFT" spacing="0" styleClass="dashboard-top-bar">

                    <ImageView fitWidth="450"
                        fitHeight="220"
                        preserveRatio="true"
                        translateX="-20"
                        translateY="8">
                        <image>
                            <Image url="@../images/Furniture_logo.jpg" />
                        </image>
                    </ImageView>

                    <Region HBox.hgrow="ALWAYS" />

                    <HBox alignment="CENTER_RIGHT" spacing="18" styleClass="date-time-box">
                        <HBox alignment="CENTER" spacing="8">
                            <Label text="📅" styleClass="date-time-icon" />
                            <Label fx:id="dateLabel" text="June 17, 2026"
                                styleClass="date-time-text" />
                        </HBox>

                        <Region styleClass="date-time-separator" />

                        <HBox alignment="CENTER" spacing="8">
                            <Label text="🕘" styleClass="date-time-icon" />
                            <Label fx:id="timeLabel" text="08:45 AM" styleClass="date-time-text" />
                        </HBox>
                    </HBox>
                </HBox>
            </VBox>

            <ScrollPane fitToWidth="true"
                hbarPolicy="NEVER"
                VBox.vgrow="ALWAYS"
                styleClass="dashboard-scroll">

                <VBox spacing="16" styleClass="dashboard-main-content">

                    <!-- TOP NAV -->
                    <HBox alignment="CENTER_LEFT" spacing="14" styleClass="product-toolbar">
                        <VBox spacing="4">
                            <Label text="Orders" styleClass="orders-page-title" />
                            <Label text="Track your purchases and delivery status."
                                styleClass="orders-page-subtitle" />
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />

                        <HBox alignment="CENTER_RIGHT" spacing="8" styleClass="user-actions-pill">

                            <Button fx:id="allProductsBtn"
                                text="All Products"
                                styleClass="top-nav-btn" />

                            <Button fx:id="wishlistBtn"
                                text="♡ Wishlist"
                                styleClass="top-nav-btn" />

                            <Button fx:id="cartTopBtn"
                                text="🛒 Cart (0)"
                                styleClass="top-nav-btn" />

                            <Button fx:id="ordersTopBtn"
                                text="📦 Orders"
                                styleClass="top-nav-btn, active-top-btn" />

                            <Button fx:id="accountTopBtn"
                                text="👤"
                                styleClass="top-account-btn" />
                        </HBox>
                    </HBox>


                    <!-- MAIN CONTENT -->
                    <HBox spacing="16" alignment="TOP_LEFT">

                        <!-- FILTER PANEL -->
                        <VBox spacing="14" prefWidth="285" styleClass="orders-filter-panel">

                            <Label text="🝖  FILTERS" styleClass="filter-title" />

                            <HBox styleClass="small-search-box">
                                <TextField fx:id="orderSearchField"
                                    promptText="Search Order ID..."
                                    styleClass="search-field"
                                    HBox.hgrow="ALWAYS" />
                                <Label text="🔍" styleClass="search-icon" />
                            </HBox>

                            <Separator styleClass="summary-separator" />

                            <Label text="Status" styleClass="filter-label" />

                            <VBox spacing="0" styleClass="status-list-box">
                                <Button fx:id="allOrdersFilterBtn"
                                    text="All Orders     ➜"
                                    maxWidth="Infinity"
                                    styleClass="status-filter-btn, status-filter-active" />

                                <Button fx:id="pendingFilterBtn"
                                    maxWidth="Infinity"
                                    styleClass="status-filter-btn">

                                    <graphic>
                                        <HBox alignment="CENTER_LEFT" spacing="10">
                                            <Label text="●" styleClass="pending-dot" />
                                            <Label text="Pending" styleClass="status-filter-text" />
                                        </HBox>
                                    </graphic>
                                </Button>

                                <Button fx:id="deliveredFilterBtn"
                                    maxWidth="Infinity"
                                    styleClass="status-filter-btn">

                                    <graphic>
                                        <HBox alignment="CENTER_LEFT" spacing="10">
                                            <Label text="●" styleClass="delivered-dot" />
                                            <Label text="Delivered" styleClass="status-filter-text" />
                                        </HBox>
                                    </graphic>
                                </Button>

                                <Button fx:id="cancelledFilterBtn"
                                    maxWidth="Infinity"
                                    styleClass="status-filter-btn">

                                    <graphic>
                                        <HBox alignment="CENTER_LEFT" spacing="10">
                                            <Label text="●" styleClass="cancelled-dot" />
                                            <Label text="Cancelled" styleClass="status-filter-text" />
                                        </HBox>
                                    </graphic>
                                </Button>
                            </VBox>

                            <Separator styleClass="summary-separator" />

                            <Label text="Date Range" styleClass="filter-label" />

                            <DatePicker fx:id="fromDatePicker"
                                promptText="From"
                                maxWidth="Infinity"
                                styleClass="orders-date-picker" />

                            <DatePicker fx:id="toDatePicker"
                                promptText="To"
                                maxWidth="Infinity"
                                styleClass="orders-date-picker" />

                            <Region prefHeight="28" />

                            <Button fx:id="clearFiltersBtn"
                                text="Clear Filters"
                                maxWidth="Infinity"
                                styleClass="outline-gold-btn" />
                        </VBox>

                        <!-- RIGHT CONTENT -->
                        <VBox spacing="16" HBox.hgrow="ALWAYS">

                            <!-- STATS -->
                            <HBox spacing="16" styleClass="orders-stats-row">

                                <HBox alignment="CENTER_LEFT" spacing="14"
                                    styleClass="order-stat-card">
                                    <StackPane styleClass="stat-icon-circle">
                                        <Label text="🛍" styleClass="stat-icon" />
                                    </StackPane>
                                    <VBox spacing="2">
                                        <Label fx:id="totalOrdersLabel" text="0"
                                            styleClass="stat-number" />
                                        <Label text="Total Orders" styleClass="stat-title" />
                                        <Label text="All time" styleClass="stat-subtitle" />
                                    </VBox>
                                </HBox>

                                <HBox alignment="CENTER_LEFT" spacing="14"
                                    styleClass="order-stat-card">
                                    <StackPane styleClass="stat-icon-circle">
                                        <Label text="⏳" styleClass="stat-icon" />
                                    </StackPane>
                                    <VBox spacing="2">
                                        <Label fx:id="pendingOrdersLabel" text="0"
                                            styleClass="stat-number, pending-text" />
                                        <Label text="Pending" styleClass="stat-title" />
                                        <Label text="Awaiting review"
                                            styleClass="stat-subtitle, pending-text" />
                                    </VBox>
                                </HBox>

                                <HBox alignment="CENTER_LEFT" spacing="14"
                                    styleClass="order-stat-card">
                                    <StackPane styleClass="stat-icon-circle, delivered-circle">
                                        <Label text="🚚" styleClass="stat-icon, delivered-text" />
                                    </StackPane>
                                    <VBox spacing="2">
                                        <Label fx:id="deliveredOrdersLabel" text="0"
                                            styleClass="stat-number, delivered-text" />
                                        <Label text="Delivered" styleClass="stat-title" />
                                        <Label text="Completed"
                                            styleClass="stat-subtitle, delivered-text" />
                                    </VBox>
                                </HBox>

                                <HBox alignment="CENTER_LEFT" spacing="14"
                                    styleClass="order-stat-card">
                                    <StackPane styleClass="stat-icon-circle, cancelled-circle">
                                        <Label text="✕" styleClass="stat-icon, cancelled-text" />
                                    </StackPane>
                                    <VBox spacing="2">
                                        <Label fx:id="cancelledOrdersLabel" text="0"
                                            styleClass="stat-number, cancelled-text" />
                                        <Label text="Cancelled" styleClass="stat-title" />
                                        <Label text="Cancelled orders"
                                            styleClass="stat-subtitle, cancelled-text" />
                                    </VBox>
                                </HBox>
                            </HBox>

                            <!--  SORT -->
                            <HBox alignment="CENTER_LEFT" spacing="12">

                                <Region HBox.hgrow="ALWAYS" />

                                <Label text="Sort by" styleClass="summary-label" />
                                <ComboBox fx:id="sortCombo"
                                    promptText="Newest First"
                                    prefWidth="160"
                                    styleClass="filter-combo" />
                            </HBox>

                            <!-- ORDERS LIST -->
                            <HBox spacing="16" VBox.vgrow="ALWAYS">

                                <ScrollPane fitToWidth="true"
                                    hbarPolicy="NEVER"
                                    prefHeight="430"
                                    HBox.hgrow="ALWAYS"
                                    styleClass="orders-list-scroll">

                                    <VBox fx:id="ordersBox"
                                        spacing="14"
                                        styleClass="orders-list-box" />
                                </ScrollPane>

                                <VBox fx:id="orderDetailsPanel"
                                    spacing="14"
                                    prefWidth="360"
                                    visible="false"
                                    managed="false"
                                    styleClass="order-details-panel">

                                    <VBox spacing="3" styleClass="advanced-panel-header">
                                        <Label text="👁 ORDER DETAILS"
                                            styleClass="advanced-panel-title" />
                                        <Label text="Full order summary and delivery information"
                                            styleClass="advanced-panel-subtitle" />
                                    </VBox>

                                    <HBox spacing="12" alignment="CENTER_LEFT"
                                        styleClass="details-header-card">
                                        <StackPane styleClass="order-details-icon-circle">
                                            <Label text="📦" styleClass="order-details-main-icon" />
                                        </StackPane>

                                        <VBox spacing="5">
                                            <Label fx:id="detailsOrderIdLabel"
                                                text="Order #"
                                                styleClass="details-customer-name" />

                                            <Label fx:id="detailsStatusLabel"
                                                text="Pending"
                                                styleClass="details-status-badge" />
                                        </VBox>
                                    </HBox>

                                    <GridPane hgap="10" vgap="10">
                                        <columnConstraints>
                                            <ColumnConstraints percentWidth="50" />
                                            <ColumnConstraints percentWidth="50" />
                                        </columnConstraints>

                                        <VBox spacing="4" styleClass="details-mini-box"
                                            GridPane.columnIndex="0" GridPane.rowIndex="0">
                                            <Label text="Order Date"
                                                styleClass="details-small-title" />
                                            <Label fx:id="detailsDateLabel" text="-"
                                                styleClass="details-value" />
                                        </VBox>

                                        <VBox spacing="4" styleClass="details-mini-box"
                                            GridPane.columnIndex="1" GridPane.rowIndex="0">
                                            <Label text="Items" styleClass="details-small-title" />
                                            <Label fx:id="detailsItemsCountLabel" text="-"
                                                styleClass="details-value" />
                                        </VBox>

                                        <VBox spacing="4" styleClass="details-mini-box"
                                            GridPane.columnIndex="0" GridPane.rowIndex="1">
                                            <Label text="Total Amount"
                                                styleClass="details-small-title" />
                                            <Label fx:id="detailsTotalLabel" text="-"
                                                styleClass="details-money" />
                                        </VBox>

                                        <VBox spacing="4" styleClass="details-mini-box"
                                            GridPane.columnIndex="1" GridPane.rowIndex="1">
                                            <Label text="Delivery" styleClass="details-small-title" />
                                            <Label fx:id="detailsDeliveryLabel" text="-"
                                                styleClass="details-value" />
                                        </VBox>
                                    </GridPane>

                                    <VBox spacing="8" styleClass="details-section-card">
                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                            <Label text="🛋" styleClass="details-gold-icon" />
                                            <Label text="PRODUCT PREVIEW"
                                                styleClass="form-section-title" />
                                        </HBox>

                                        <HBox spacing="10" alignment="CENTER_LEFT">
                                            <ImageView fx:id="detailsProductImage"
                                                fitWidth="82"
                                                fitHeight="62"
                                                preserveRatio="false"
                                                styleClass="details-product-image" />

                                            <VBox spacing="4">
                                                <Label fx:id="detailsProductNameLabel"
                                                    text="-"
                                                    wrapText="true"
                                                    styleClass="details-value" />

                                                <Label fx:id="detailsNoteLabel"
                                                    text="-"
                                                    wrapText="true"
                                                    styleClass="details-description" />
                                            </VBox>
                                        </HBox>
                                    </VBox>
                                    <VBox spacing="8" styleClass="details-section-card">

                                            <HBox spacing="8" alignment="CENTER_LEFT">
                                                <Label text="📋" styleClass="details-gold-icon" />
                                                <Label text="ORDER ITEMS"
                                                    styleClass="form-section-title" />
                                            </HBox>

                                            <VBox fx:id="detailsItemsBox"
                                                spacing="6">
                                            </VBox>

                                        </VBox> 

                                    <VBox spacing="8" styleClass="details-section-card">
                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                            <Label text="🚚" styleClass="details-gold-icon" />
                                            <Label text="ORDER STATUS"
                                                styleClass="form-section-title" />
                                        </HBox>

                                        <Label fx:id="detailsStatusMessageLabel"
                                            text="-"
                                            wrapText="true"
                                            styleClass="details-description" />
                                    </VBox>

                                    <Region VBox.vgrow="ALWAYS" />

                                    <Button fx:id="closeDetailsBtn"
                                        text="CLOSE"
                                        maxWidth="Infinity"
                                        styleClass="luxury-cancel-btn" />
                                </VBox>
                            </HBox>
                        </VBox>
                    </HBox>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>