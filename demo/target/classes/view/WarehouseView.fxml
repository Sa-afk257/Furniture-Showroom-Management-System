<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<BorderPane xmlns="http://javafx.com/javafx"
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="com.furniture.ui.WarehouseController"
    stylesheets="@../style/warehouse.css"
    prefWidth="1300"
    prefHeight="780"
    styleClass="root-pane">

    <!-- MAIN CONTENT -->
    <center>

        <ScrollPane fitToWidth="true"
            fitToHeight="false"
            hbarPolicy="NEVER"
            vbarPolicy="NEVER"
            styleClass="dashboard-scroll">

            <content>

                <VBox fx:id="dashboardContainer"
                    spacing="15"
                    HBox.hgrow="ALWAYS"
                    styleClass="dashboard-main-content">

                    <HBox alignment="CENTER_LEFT"
                        spacing="14"
                        styleClass="stats-cards-row">

                        <HBox alignment="CENTER_LEFT"
                            spacing="8"
                            styleClass="dashboard-stat-card">

                            <ImageView fitWidth="92"
                                fitHeight="92"
                                preserveRatio="true">

                                <image>
                                    <Image
                                        url="@../images/icons/totalWarehouse_icon.jpg" />
                                </image>

                            </ImageView>

                            <VBox spacing="2"
                                HBox.hgrow="ALWAYS"
                                alignment="CENTER_LEFT">

                                <Label fx:id="totalWarehousesLabel"
                                    text="0"
                                    styleClass="product-card-number" />

                                <Label text="Total Warehouses"
                                    styleClass="product-card-title" />

                            </VBox>

                        </HBox>

                        <HBox alignment="CENTER_LEFT"
                            spacing="8"
                            styleClass="dashboard-stat-card">

                            <ImageView fitWidth="92"
                                fitHeight="92"
                                preserveRatio="true">

                                <image>
                                    <Image
                                        url="@../images/icons/totalCapacity_icon.jpg" />
                                </image>

                            </ImageView>

                            <VBox spacing="2"
                                HBox.hgrow="ALWAYS"
                                alignment="CENTER_LEFT">

                                <Label fx:id="totalCapacityLabel"
                                    text="0"
                                    styleClass="product-card-number" />

                                <Label text="Total Capacity"
                                    styleClass="product-card-title" />

                            </VBox>

                        </HBox>

                        <HBox alignment="CENTER_LEFT"
                            spacing="8"
                            styleClass="dashboard-stat-card">

                            <ImageView fitWidth="92"
                                fitHeight="92"
                                preserveRatio="true">

                                <image>
                                    <Image
                                        url="@../images/icons/usedCapacity_icon.jpg" />
                                </image>

                            </ImageView>

                            <VBox spacing="2"
                                HBox.hgrow="ALWAYS"
                                alignment="CENTER_LEFT">

                                <Label fx:id="usedCapacityLabel"
                                    text="0"
                                    styleClass="product-card-number" />

                                <Label text="Used Capacity"
                                    styleClass="product-card-title" />

                            </VBox>

                        </HBox>

                        <HBox alignment="CENTER_LEFT"
                            spacing="8"
                            styleClass="dashboard-stat-card">

                            <ImageView fitWidth="92"
                                fitHeight="92"
                                preserveRatio="true">

                                <image>
                                    <Image
                                        url="@../images/icons/availableCapacity_icon.jpg" />
                                </image>

                            </ImageView>

                            <VBox spacing="2"
                                HBox.hgrow="ALWAYS"
                                alignment="CENTER_LEFT">

                                <Label fx:id="availableCapacityLabel"
                                    text="0"
                                    styleClass="product-card-number" />

                                <Label text="Available Capacity"
                                    styleClass="product-card-title" />

                            </VBox>

                        </HBox>

                        <HBox alignment="CENTER_LEFT"
                            spacing="8"
                            styleClass="dashboard-stat-card">

                            <ImageView fitWidth="92"
                                fitHeight="92"
                                preserveRatio="true">

                                <image>
                                    <Image
                                        url="@../images/icons/fullWarehouses_icon.jpg" />
                                </image>

                            </ImageView>

                            <VBox spacing="2"
                                HBox.hgrow="ALWAYS"
                                alignment="CENTER_LEFT">

                                <Label fx:id="fullWarehousesLabel"
                                    text="0"
                                    styleClass="product-card-number" />

                                <Label text="Full Warehouses"
                                    styleClass="product-card-title" />

                            </VBox>

                        </HBox>

                    </HBox>
                    <HBox alignment="CENTER_LEFT"
                        spacing="14"
                        styleClass="product-toolbar">

                        <HBox styleClass="search-box">
                            <TextField fx:id="searchField"
                                promptText="Search warehouse by name, manager..."
                                styleClass="search-field"
                                HBox.hgrow="ALWAYS" />

                            <Label text="🔍"
                                styleClass="search-icon" />
                        </HBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <Button fx:id="filterToggleBtn"
                            text="🝖 FILTER"
                            styleClass="filter-toggle-btn" />
                        <Button fx:id="addWarehouseBtn"
                            styleClass="add-product-btn">

                            <graphic>
                                <Label text="✚"
                                    styleClass="button-icon" />
                            </graphic>

                            <text>ADD Warehouse</text>

                        </Button>

                        <Button fx:id="exportBtn" styleClass="export-btn">

                            <graphic>
                                <Label text="➜]"
                                    styleClass="button-icon" />
                            </graphic>

                            <text>EXPORT</text>

                        </Button>

                    </HBox>

                    <!-- TABLE -->
                    <HBox spacing="16" VBox.vgrow="ALWAYS"
                        styleClass="products-content-row">

                        <!-- FILTER PANEL -->
                        <VBox fx:id="filterPanel"
                            spacing="12"
                            styleClass="smart-filter-panel"
                            visible="false"
                            managed="false">

                            <VBox spacing="2">
                                <Label text="🝖  FILTER WAREHOUSES"
                                    styleClass="filter-title" />
                            </VBox>

                            <Separator styleClass="filter-separator" />

                            <Label text="Warehouse"
                                styleClass="filter-label" />
                            <ComboBox fx:id="warehouseCombo"
                                promptText="All Warehouses"
                                styleClass="filter-combo" />

                            <Label text="Manager"
                                styleClass="filter-label" />
                            <ComboBox fx:id="managerCombo"
                                promptText="All Managers"
                                styleClass="filter-combo" />

                            <Label text="City"
                                styleClass="filter-label" />
                            <ComboBox fx:id="cityCombo"
                                promptText="All Cities"
                                styleClass="filter-combo" />

                            <Label text="Status"
                                styleClass="filter-label" />
                            <ComboBox fx:id="warehouseStatusCombo"
                                promptText="All Status"
                                styleClass="filter-combo" />

                            <Label text="Capacity Range"
                                styleClass="filter-label" />
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <TextField fx:id="minCapacityField"
                                    promptText="Min"
                                    styleClass="price-input" />

                                <Label text="-"
                                    styleClass="filter-small-text" />

                                <TextField fx:id="maxCapacityField"
                                    promptText="Max"
                                    styleClass="price-input" />
                            </HBox>

                            <Label text="Used % Range"
                                styleClass="filter-label" />
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <TextField fx:id="minUsedPercentField"
                                    promptText="Min"
                                    styleClass="price-input" />

                                <Label text="-"
                                    styleClass="filter-small-text" />

                                <TextField fx:id="maxUsedPercentField"
                                    promptText="Max"
                                    styleClass="price-input" />
                            </HBox>

                            <VBox spacing="10" alignment="CENTER"
                                styleClass="filter-actions">

                                <Button fx:id="applyFiltersBtn"
                                    text="🝖  APPLY FILTERS"
                                    styleClass="apply-filter-btn" />

                                <Button fx:id="resetFiltersBtn"
                                    text="⟲  RESET FILTERS"
                                    styleClass="reset-filter-btn" />

                            </VBox>

                            <HBox spacing="14" alignment="CENTER_LEFT"
                                styleClass="found-box">

                                <Label text="🏬"
                                    styleClass="found-icon" />

                                <VBox spacing="0">
                                    <Label text="Warehouses Found"
                                        styleClass="found-title" />

                                    <Label fx:id="warehousesFoundLabel"
                                        text="0"
                                        styleClass="found-number" />
                                </VBox>

                            </HBox>

                        </VBox>
                        <VBox fx:id="addWarehousePanel"
                            spacing="16"
                            styleClass="add-product-panel"
                            visible="false"
                            managed="false">

                            <ScrollPane fitToWidth="true"
                                hbarPolicy="NEVER"
                                vbarPolicy="AS_NEEDED"
                                styleClass="form-scroll">

                                <content>
                                    <VBox spacing="14">

                                        <VBox spacing="3" styleClass="add-title-box">
                                            <Label fx:id="formTitleLabel"
                                                text="✚  ADD WAREHOUSE"
                                                styleClass="add-panel-title" />
                                        </VBox>

                                        <VBox spacing="14">

                                            <Label text="WAREHOUSE INFORMATION"
                                                styleClass="form-section-title" />

                                            <VBox spacing="3" styleClass="form-field-box">
                                                <HBox spacing="8" alignment="CENTER_LEFT">
                                                    <Label text="🏬" styleClass="form-icon" />
                                                    <Label text="Warehouse Name"
                                                        styleClass="form-label" />
                                                    <Label text="*"
                                                        style="-fx-text-fill: red; -fx-font-weight: bold;" />
                                                    <Label fx:id="warehouseNameWarningLabel"
                                                        text="⚠"
                                                        visible="false"
                                                        managed="false"
                                                        styleClass="warning-label" />
                                                </HBox>

                                                <TextField fx:id="addWarehouseNameField"
                                                    promptText="Warehouse Name"
                                                    styleClass="luxury-input" />
                                            </VBox>

                                            <VBox spacing="3" styleClass="form-field-box">
                                                <HBox spacing="8" alignment="CENTER_LEFT">
                                                    <Label text="🧑‍💼" styleClass="form-icon" />
                                                    <Label text="Manager" styleClass="form-label" />
                                                    <Label text="*"
                                                        style="-fx-text-fill: red; -fx-font-weight: bold;" />
                                                    <Label fx:id="managerWarningLabel"
                                                        text="⚠"
                                                        visible="false"
                                                        managed="false"
                                                        styleClass="warning-label" />
                                                </HBox>

                                                <ComboBox fx:id="addManagerCombo"
                                                    promptText="Select Manager"
                                                    maxWidth="Infinity"
                                                    styleClass="filter-combo" />
                                            </VBox>

                                            <VBox spacing="3" styleClass="form-field-box">
                                                <HBox spacing="8" alignment="CENTER_LEFT">
                                                    <Label text="📦" styleClass="form-icon" />
                                                    <Label text="Capacity" styleClass="form-label" />
                                                    <Label text="*"
                                                        style="-fx-text-fill: red; -fx-font-weight: bold;" />
                                                    <Label fx:id="capacityWarningLabel"
                                                        text="⚠"
                                                        visible="false"
                                                        managed="false"
                                                        styleClass="warning-label" />
                                                </HBox>

                                                <TextField fx:id="addCapacityField"
                                                    promptText="Warehouse Capacity"
                                                    styleClass="luxury-input" />
                                            </VBox>

                                            <Separator styleClass="filter-separator" />

                                            <Label text="ADDRESS INFORMATION"
                                                styleClass="form-section-title" />

                                            <VBox spacing="3" styleClass="form-field-box">
                                                <HBox spacing="8" alignment="CENTER_LEFT">
                                                    <Label text="🏙️" styleClass="form-icon" />
                                                    <Label text="City" styleClass="form-label" />
                                                    <Label text="*"
                                                        style="-fx-text-fill: red; -fx-font-weight: bold;" />
                                                    <Label fx:id="cityWarningLabel"
                                                        text="⚠"
                                                        visible="false"
                                                        managed="false"
                                                        styleClass="warning-label" />
                                                </HBox>

                                                <TextField fx:id="addCityField"
                                                    promptText="City"
                                                    styleClass="luxury-input" />
                                            </VBox>

                                            <VBox spacing="3" styleClass="form-field-box">
                                                <HBox spacing="8" alignment="CENTER_LEFT">
                                                    <Label text="📍" styleClass="form-icon" />
                                                    <Label text="Town" styleClass="form-label" />
                                                </HBox>

                                                <TextField fx:id="addTownField"
                                                    promptText="Town"
                                                    styleClass="luxury-input" />
                                            </VBox>

                                            <VBox spacing="3" styleClass="form-field-box">
                                                <HBox spacing="8" alignment="CENTER_LEFT">
                                                    <Label text="📌" styleClass="form-icon" />
                                                    <Label text="Area" styleClass="form-label" />
                                                </HBox>

                                                <TextField fx:id="addAreaField"
                                                    promptText="Area"
                                                    styleClass="luxury-input" />
                                            </VBox>

                                            <VBox spacing="3" styleClass="form-field-box">
                                                <HBox spacing="8" alignment="CENTER_LEFT">
                                                    <Label text="🛣️" styleClass="form-icon" />
                                                    <Label text="Street" styleClass="form-label" />
                                                </HBox>

                                                <TextField fx:id="addStreetField"
                                                    promptText="Street"
                                                    styleClass="luxury-input" />
                                            </VBox>

                                            <VBox spacing="3" styleClass="form-field-box">
                                                <HBox spacing="8" alignment="CENTER_LEFT">
                                                    <Label text="🏠" styleClass="form-icon" />
                                                    <Label text="Building" styleClass="form-label" />
                                                </HBox>

                                                <TextField fx:id="addBuildingField"
                                                    promptText="Building"
                                                    styleClass="luxury-input" />
                                            </VBox>

                                        </VBox>
                                    </VBox>
                                </content>
                            </ScrollPane>

                            <Button fx:id="saveWarehouseBtn"
                                text="✚  ADD WAREHOUSE"
                                maxWidth="Infinity"
                                styleClass="luxury-add-btn" />

                            <Button fx:id="cancelAddBtn"
                                text="CANCEL"
                                maxWidth="Infinity"
                                styleClass="luxury-cancel-btn" />

                        </VBox>
                        <VBox fx:id="warehouseDetailsPanel"
                            spacing="14"
                            styleClass="customer-details-panel"
                            visible="false"
                            managed="false">

                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label text="🏬" styleClass="details-title-icon" />
                                <Label text="WAREHOUSE DETAILS" styleClass="details-title" />
                            </HBox>

                            <VBox spacing="14" styleClass="details-inner-card">

                                <HBox spacing="12"
                                    alignment="CENTER_LEFT"
                                    styleClass="details-header-card">

                                    <StackPane styleClass="customer-avatar-circle">
                                        <Label text="🏬"
                                            styleClass="customer-avatar-icon" />
                                    </StackPane>

                                    <VBox spacing="5" HBox.hgrow="ALWAYS">

                                        <Label fx:id="detailsWarehouseIdLabel"
                                            text="Warehouse #2"
                                            styleClass="details-customer-name" />

                                        <HBox spacing="8">
                                            <Label text="🏷"
                                                styleClass="details-gold-icon" />
                                            <Label fx:id="detailsWarehouseNameLabel"
                                                text="Secondary Warehouse"
                                                styleClass="details-text" />
                                        </HBox>

                                        <HBox spacing="8">
                                            <Label text="🧑‍💼"
                                                styleClass="details-gold-icon" />
                                            <Label fx:id="detailsManagerNameLabel"
                                                text="Dana S Omar"
                                                styleClass="details-text" />
                                        </HBox>

                                    </VBox>

                                    <VBox spacing="2" alignment="CENTER_RIGHT">
                                        <Label text="STATUS"
                                            styleClass="details-small-title" />
                                        <Label fx:id="detailsWarehouseStatusLabel"
                                            text="-"
                                            styleClass="details-type-badge" />
                                    </VBox>

                                </HBox>

                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <Label text="CAPACITY SUMMARY"
                                        styleClass="details-section-title" />
                                    <Separator HBox.hgrow="ALWAYS"
                                        styleClass="details-separator" />
                                </HBox>

                                <GridPane hgap="12" vgap="12">

                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="50" />
                                        <ColumnConstraints percentWidth="50" />
                                    </columnConstraints>

                                    <VBox spacing="3" styleClass="details-mini-box"
                                        GridPane.columnIndex="0" GridPane.rowIndex="0">

                                        <HBox spacing="7" alignment="CENTER_LEFT">
                                            <Label text="📦" styleClass="details-gold-icon" />
                                            <Label text="Capacity" styleClass="details-small-title" />
                                        </HBox>

                                        <Label fx:id="detailsCapacityLabel"
                                            text="0"
                                            styleClass="details-value" />
                                    </VBox>

                                    <VBox spacing="3" styleClass="details-mini-box"
                                        GridPane.columnIndex="1" GridPane.rowIndex="0">

                                        <HBox spacing="7" alignment="CENTER_LEFT">
                                            <Label text="📊" styleClass="details-gold-icon" />
                                            <Label text="Used %" styleClass="details-small-title" />
                                        </HBox>

                                        <Label fx:id="detailsUsedPercentLabel"
                                            text="0%"
                                            styleClass="details-value" />
                                    </VBox>

                                    <VBox spacing="3" styleClass="details-mini-box"
                                        GridPane.columnIndex="0" GridPane.rowIndex="1">

                                        <HBox spacing="7" alignment="CENTER_LEFT">
                                            <Label text="📥" styleClass="details-gold-icon" />
                                            <Label text="Used Capacity"
                                                styleClass="details-small-title" />
                                        </HBox>

                                        <Label fx:id="detailsUsedCapacityLabel"
                                            text="0"
                                            styleClass="details-value" />
                                    </VBox>

                                    <VBox spacing="3" styleClass="details-mini-box"
                                        GridPane.columnIndex="1" GridPane.rowIndex="1">

                                        <HBox spacing="7" alignment="CENTER_LEFT">
                                            <Label text="📤" styleClass="details-gold-icon" />
                                            <Label text="Remaining" styleClass="details-small-title" />
                                        </HBox>

                                        <Label fx:id="detailsRemainingCapacityLabel"
                                            text="0"
                                            styleClass="details-value" />
                                    </VBox>

                                    <VBox spacing="3" styleClass="details-mini-box"
                                        GridPane.columnIndex="0" GridPane.rowIndex="2">

                                        <HBox spacing="7" alignment="CENTER_LEFT">
                                            <Label text="🛋" styleClass="details-gold-icon" />
                                            <Label text="Products" styleClass="details-small-title" />
                                        </HBox>

                                        <Label fx:id="detailsProductsCountLabel"
                                            text="0"
                                            styleClass="details-value" />
                                    </VBox>

                                    <VBox spacing="3" styleClass="details-mini-box"
                                        GridPane.columnIndex="1" GridPane.rowIndex="2">

                                        <HBox spacing="7" alignment="CENTER_LEFT">
                                            <Label text="🏷" styleClass="details-gold-icon" />
                                            <Label text="Status" styleClass="details-small-title" />
                                        </HBox>

                                        <Label fx:id="detailsWarehouseStatusGridLabel"
                                            text="-"
                                            styleClass="details-value" />
                                    </VBox>

                                </GridPane>

                                <Separator styleClass="filter-separator" />

                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="📍" styleClass="details-gold-icon" />
                                    <Label text="ADDRESS INFORMATION"
                                        styleClass="form-section-title" />
                                </HBox>

                                <GridPane hgap="12" vgap="12">

                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="50" />
                                        <ColumnConstraints percentWidth="50" />
                                    </columnConstraints>

                                    <VBox spacing="3" styleClass="details-mini-box"
                                        GridPane.columnIndex="0" GridPane.rowIndex="0">
                                        <Label text="City" styleClass="details-small-title" />
                                        <Label fx:id="detailsCityLabel" text="-"
                                            styleClass="details-value" />
                                    </VBox>

                                    <VBox spacing="3" styleClass="details-mini-box"
                                        GridPane.columnIndex="1" GridPane.rowIndex="0">
                                        <Label text="Town" styleClass="details-small-title" />
                                        <Label fx:id="detailsTownLabel" text="-"
                                            styleClass="details-value" />
                                    </VBox>

                                    <VBox spacing="3" styleClass="details-mini-box"
                                        GridPane.columnIndex="0" GridPane.rowIndex="1">
                                        <Label text="Area" styleClass="details-small-title" />
                                        <Label fx:id="detailsAreaLabel" text="-"
                                            styleClass="details-value" />
                                    </VBox>

                                    <VBox spacing="3" styleClass="details-mini-box"
                                        GridPane.columnIndex="1" GridPane.rowIndex="1">
                                        <Label text="Street" styleClass="details-small-title" />
                                        <Label fx:id="detailsStreetLabel" text="-"
                                            styleClass="details-value" />
                                    </VBox>

                                    <VBox spacing="3" styleClass="details-mini-box"
                                        GridPane.columnIndex="0" GridPane.rowIndex="2">
                                        <Label text="Building" styleClass="details-small-title" />
                                        <Label fx:id="detailsBuildingLabel" text="-"
                                            styleClass="details-value" />
                                    </VBox>

                                </GridPane>

                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="📦" styleClass="details-gold-icon" />
                                    <Label text="PRODUCTS IN THIS WAREHOUSE"
                                        styleClass="form-section-title" />
                                </HBox>

                                <TableView fx:id="warehouseProductsTable"
                                    prefHeight="230"
                                    styleClass="product-table">

                                    <columns>

                                        <TableColumn fx:id="colDetailProductName"
                                            text="Product"
                                            prefWidth="130" />

                                        <TableColumn fx:id="colDetailCategory"
                                            text="Category"
                                            prefWidth="105" />

                                        <TableColumn fx:id="colDetailQuantity"
                                            text="Qty"
                                            prefWidth="75" />

                                        <TableColumn fx:id="colDetailPrice"
                                            text="Price"
                                            prefWidth="85" />

                                        <TableColumn fx:id="colDetailStatus"
                                            text="Status"
                                            prefWidth="100" />

                                    </columns>

                                </TableView>

                                <Button fx:id="closeDetailsBtn"
                                    text="CLOSE"
                                    maxWidth="Infinity"
                                    styleClass="luxury-cancel-btn" />

                            </VBox>
                        </VBox>

                        <!-- TABLE + ACTION BUTTONS -->
                        <VBox HBox.hgrow="ALWAYS"
                            spacing="10"
                            minWidth="0">

                            <TableView fx:id="warehouseTable"
                                styleClass="product-table"
                                VBox.vgrow="ALWAYS">

                                <columns>

                                    <TableColumn fx:id="colNo"
                                        text="No."
                                        prefWidth="60" />

                                    <TableColumn fx:id="colWarehouseID"
                                        text="Warehouse ID"
                                        prefWidth="110" />

                                    <TableColumn fx:id="colWarehouseName"
                                        text="Warehouse Name"
                                        prefWidth="180" />

                                    <TableColumn fx:id="colManagerName"
                                        text="Manager"
                                        prefWidth="160" />

                                    <TableColumn fx:id="colCapacity"
                                        text="Capacity"
                                        prefWidth="110" />

                                    <TableColumn fx:id="colUsedPercent"
                                        text="Used %"
                                        prefWidth="100" />

                                    <TableColumn fx:id="colProductsCount"
                                        text="Products"
                                        prefWidth="95" />

                                    <TableColumn fx:id="colWarehouseStatus"
                                        text="Status"
                                        prefWidth="110" />

                                    <TableColumn fx:id="colAction"
                                        text="Actions"
                                        prefWidth="130" />

                                </columns>

                            </TableView>

                            <HBox spacing="14"
                                alignment="CENTER_LEFT"
                                styleClass="table-actions-bar">

                                <Button fx:id="undoBtn"
                                    text="↶  UNDO"
                                    styleClass="action-dark-btn" />

                                <Button fx:id="redoBtn"
                                    text="↷  REDO"
                                    styleClass="action-dark-btn" />

                                <Button fx:id="resetBtn"
                                    text="⟳  RESET"
                                    styleClass="action-reset-btn" />

                                <Region HBox.hgrow="ALWAYS" />

                                <Button fx:id="saveAllBtn"
                                    text="💾  SAVE"
                                    styleClass="action-save-btn" />

                            </HBox>

                        </VBox>
                    </HBox>
                </VBox>
            </content>

        </ScrollPane>

    </center>

</BorderPane>