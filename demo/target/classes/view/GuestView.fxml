<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.transform.Scale?>

<BorderPane xmlns="http://javafx.com/javafx"
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="com.furniture.ui.GuestController"
    stylesheets="@../style/guest.css"
    styleClass="root-pane">

    <center>

        <VBox HBox.hgrow="ALWAYS"
            spacing="0"
            styleClass="main-area">

            <!-- TOP BAR -->
            <VBox spacing="0" styleClass="dashboard-header">

                <HBox alignment="CENTER_LEFT"
                    spacing="0"
                    styleClass="dashboard-top-bar">

                    <HBox alignment="CENTER_LEFT" spacing="20">

                        <ImageView
                            fitWidth="450"
                            fitHeight="220"
                            preserveRatio="true"
                            translateX="-20"
                            translateY="8">

                            <image>
                                <Image url="@../images/Furniture_logo.jpg" />
                            </image>

                        </ImageView>

                    </HBox>

                    <Region HBox.hgrow="ALWAYS" />

                    <HBox alignment="CENTER_RIGHT"
                        spacing="18"
                        styleClass="date-time-box">

                        <HBox alignment="CENTER" spacing="8">
                            <Label text="📅" styleClass="date-time-icon" />
                            <Label fx:id="dateLabel"
                                text="May 28, 2026"
                                styleClass="date-time-text" />
                        </HBox>

                        <Region styleClass="date-time-separator" />

                        <HBox alignment="CENTER" spacing="8">
                            <Label text="🕘" styleClass="date-time-icon" />
                            <Label fx:id="timeLabel"
                                text="10:45 AM"
                                styleClass="date-time-text" />
                        </HBox>
                    </HBox>
                </HBox>
            </VBox>

            <!-- PAGE CONTENT -->
            <ScrollPane fitToWidth="true"
                hbarPolicy="NEVER"
                styleClass="dashboard-scroll"
                VBox.vgrow="ALWAYS">

                <VBox spacing="15"
                    styleClass="dashboard-main-content">

                    <!-- TOOLBAR -->
                    <StackPane styleClass="toolbar-stack">

                        <HBox alignment="CENTER_LEFT"
                            spacing="14"
                            styleClass="product-toolbar">

                            <HBox styleClass="search-box">
                                <TextField fx:id="searchField"
                                    promptText="Search product by name, category..."
                                    styleClass="search-field"
                                    HBox.hgrow="ALWAYS" />

                                <Label text="🔍" styleClass="search-icon" />
                            </HBox>

                            <Region HBox.hgrow="ALWAYS" />

                            <HBox fx:id="guestActionsBox"
                                alignment="CENTER_RIGHT"
                                spacing="10"
                                styleClass="user-actions-box">

                                <Button fx:id="loginTopBtn"
                                    text="LOGIN / SIGNUP"
                                    onAction="#openLoginPage"
                                    styleClass="login-top-btn" />
                            </HBox>

                            <HBox fx:id="userActionsBox"
                                alignment="CENTER_RIGHT"
                                spacing="8"
                                visible="false"
                                managed="false"
                                styleClass="user-actions-pill">

                                <Button fx:id="allProductsBtn"
                                    text="All Products"
                                    onAction="#openAllProductsPage"
                                    styleClass="top-nav-btn" />

                                <Button fx:id="wishlistBtn"
                                    text="♡ Wishlist"
                                    onAction="#openWishlistPage"
                                    styleClass="top-nav-btn" />

                                <Button fx:id="cartTopBtn"
                                    text="🛒 Cart (0)"
                                    onAction="#openCartPage"
                                    styleClass="top-nav-btn" />

                                <Button fx:id="ordersTopBtn"
                                    text="📦 Orders"
                                    onAction="#openOrdersPage"
                                    styleClass="top-nav-btn" />

                                <Button fx:id="accountTopBtn"
                                    text="👤"
                                    styleClass="top-account-btn" />
                            </HBox>
                        </HBox>

                    </StackPane>

                    <!-- FILTER + CARDS -->
                    <HBox spacing="16"
                        alignment="TOP_LEFT"
                        VBox.vgrow="ALWAYS"
                        styleClass="products-content-row">

                        <!-- FILTER PANEL -->
                        <VBox fx:id="filterPanel"
                            spacing="14"
                            styleClass="smart-filter-panel">

                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="⚱" styleClass="filter-title-icon" />
                                <Label text="FILTERS" styleClass="filter-title" />
                            </HBox>

                            <HBox styleClass="filter-search-box">
                                <TextField fx:id="filterSearchField"
                                    promptText="Search in products..."
                                    styleClass="filter-search-field"
                                    HBox.hgrow="ALWAYS" />
                                <Label text="🔍" styleClass="search-icon" />
                            </HBox>

                            <Label text="Category" styleClass="filter-label" />
                            <ComboBox fx:id="categoryCombo"
                                promptText="All Categories"
                                styleClass="filter-combo" />

                            <Label text="Price Range" styleClass="filter-label" />

                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="\$" styleClass="filter-small-text" />
                                <TextField fx:id="minPriceField"
                                    text="200"
                                    styleClass="price-input" />
                                <Label text="to" styleClass="filter-small-text" />
                                <TextField fx:id="maxPriceField"
                                    text="5000"
                                    styleClass="price-input" />
                            </HBox>

                            <Slider fx:id="priceSlider"
                                min="0"
                                max="5000"
                                value="5000"
                                styleClass="price-slider" />

                            <HBox alignment="CENTER_LEFT">
                                <Label fx:id="minPriceLabel" text="\$200"
                                    styleClass="price-range-label" />
                                <Region HBox.hgrow="ALWAYS" />

                                <Label fx:id="maxPriceLabel" text="\$5000"
                                    styleClass="price-range-label" />
                            </HBox>

                            <Label text="Colors" styleClass="filter-label" />
                            <FlowPane fx:id="colorsPane" hgap="10" vgap="10" />

                            <Label text="Material" styleClass="filter-label" />
                            <FlowPane fx:id="materialsPane"
                                hgap="14"
                                vgap="8"
                                prefWrapLength="220" />

                            <Label text="Availability" styleClass="filter-label" />
                            <VBox spacing="8">
                                <RadioButton fx:id="allAvailabilityRadio"
                                    text="All"
                                    selected="true"
                                    styleClass="filter-radio" />

                                <RadioButton fx:id="inStockRadio"
                                    text="In Stock"
                                    styleClass="filter-radio" />

                                <RadioButton fx:id="lowStockRadio"
                                    text="Low Stock"
                                    styleClass="filter-radio" />

                                <RadioButton fx:id="outOfStockRadio"
                                    text="Out of Stock"
                                    styleClass="filter-radio" />
                            </VBox>

                            <Button fx:id="resetFiltersBtn"
                                text="⟲  RESET FILTERS"
                                maxWidth="Infinity"
                                styleClass="reset-filter-btn" />

                            <HBox spacing="14"
                                alignment="CENTER_LEFT"
                                styleClass="found-box">

                                <Label text="🪑" styleClass="found-icon" />

                                <VBox spacing="0">
                                    <Label text="Products Found" styleClass="found-title" />
                                    <Label fx:id="productsFoundLabel"
                                        text="0"
                                        styleClass="found-number" />
                                </VBox>
                            </HBox>
                        </VBox>
                        <!-- CARDS AREA -->
                        <TilePane fx:id="productsCardsPane"
                            hgap="16"
                            vgap="16"
                            prefColumns="4"
                            HBox.hgrow="ALWAYS"
                            styleClass="products-cards-pane" />
                    </HBox>
                </VBox>

            </ScrollPane>
        </VBox>

    </center>
</BorderPane>